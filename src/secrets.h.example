#pragma once
//
// secrets.h.example — template for the gitignored secrets.h.
// Copy this file to secrets.h (in the same src/ directory) and fill in your
// own values. config.h #includes secrets.h, so main.cpp only needs config.h.
//   cp src/secrets.h.example src/secrets.h
//

// WiFi credentials
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Philips Hue bridge — v2 (HTTPS). Bridge IP on your LAN + an application key.
// Get the key via the CLIP v2 onboarding flow (press the bridge link button,
// POST to /api). HUE_V2_BASE_URL and HUE_BRIDGE_HOST share the same IP.
#define HUE_V2_BASE_URL "https://192.168.1.x/clip/v2"
#define HUE_BRIDGE_HOST "192.168.1.x"
#define HUE_API_KEY     "your-hue-application-key"

// Light UUIDs — from: GET https://<bridge>/clip/v2/resource/light
// Map each physical bulb to a cache slot (see LIGHT_* indices in config.h).
#define LIGHT_UUID_CHEST    "00000000-0000-0000-0000-000000000000"
#define LIGHT_UUID_DRESSER  "00000000-0000-0000-0000-000000000000"
#define LIGHT_UUID_CEIL_1   "00000000-0000-0000-0000-000000000000"
#define LIGHT_UUID_CEIL_2   "00000000-0000-0000-0000-000000000000"
#define LIGHT_UUID_FLOOR    "00000000-0000-0000-0000-000000000000"

// Dashboard (Railway or your own host) + the bearer token the firmware sends.
// ESP32_API_KEY must match the ESP32_API_KEY env var on the dashboard.
#define DASHBOARD_BASE_URL "https://your-dashboard.example.app"
#define ESP32_API_KEY      "your-shared-bearer-token"
